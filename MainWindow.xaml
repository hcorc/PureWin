<ui:FluentWindow x:Class="PureWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:PureWin"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="PureWin" 
        Height="860" Width="1320"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Window.Resources>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Modern Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="PureWin" Padding="0,4,0,4">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/Assets/PureWin_icon_64.png" Width="24" Height="24" Margin="0,0,16,0"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="PureWin" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Border x:Name="AdminBadgeBorder" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="8" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AdminBadgeText" Text="● Yönetici Modu" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" />
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <ui:Button x:Name="AboutInfoBtn" Click="AboutInfo_Click" ToolTip="Hakkında"
                           AutomationProperties.Name="Hakkında"
                           Appearance="Transparent" Padding="0" Margin="0,4,6,0"
                           Width="22" Height="22" MinWidth="0" MinHeight="0" CornerRadius="11"
                           VerticalAlignment="Top"
                           shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ui:SymbolIcon Symbol="Info24" FontSize="13" />
                </ui:Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Ana Çalışma Alanı -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SOL PANEL (Yan Menü) -->
            <Border Grid.Column="0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" 
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Menü Butonları ve Gruplar -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,0">
                            <!-- 1. Grup: Tweak & Debloat -->
                            <TextBlock Text="Tweak &amp; Debloat" FontSize="11" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,4,0,10" />

                            <!-- 1. Sırada: Sistem Raporu (Ana Karşılama Ekranı) -->
                            <ui:Button x:Name="NavReportBtn" Click="NavReport_Click" 
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                       Padding="12,10" CornerRadius="8" Appearance="Primary" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="15" Margin="0,0,10,0" />
                                    <TextBlock Text="Sistem Raporu" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- 2. Sırada: Bloatware Kaldırıcı -->
                            <ui:Button x:Name="NavBloatwareBtn" Click="NavBloatware_Click" 
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                       Padding="12,10" CornerRadius="8" Appearance="Secondary" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑️" FontSize="15" Margin="0,0,10,0" />
                                    <TextBlock Text="Bloatware Kaldırıcı" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- 3. Sırada: Sistem İnce Ayarları -->
                            <ui:Button x:Name="NavTweaksBtn" Click="NavTweaks_Click" 
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                       Padding="12,10" CornerRadius="8" Appearance="Secondary" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="15" Margin="0,0,10,0" />
                                    <TextBlock Text="Sistem İnce Ayarları" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- 4. Sırada: Windows Servisleri -->
                            <ui:Button x:Name="NavServicesBtn" Click="NavServices_Click" 
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                       Padding="12,10" CornerRadius="8" Appearance="Secondary" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛠️" FontSize="15" Margin="0,0,10,0" />
                                    <TextBlock Text="Windows Servisleri" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- 2. Grup: Temizlik & Sağlık -->
                            <TextBlock Text="Temizlik &amp; Sağlık" FontSize="11" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,16,0,10" />

                            <!-- 5. Sırada: Sistem Temizliği -->
                            <ui:Button x:Name="NavCleanupBtn" Click="NavCleanup_Click" 
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                       Padding="12,10" CornerRadius="8" Appearance="Secondary" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧹" FontSize="15" Margin="0,0,10,0" />
                                    <TextBlock Text="Sistem Temizliği" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- 6. Sırada: Sistem Sağlığı -->
                            <ui:Button x:Name="NavSystemHealthBtn" Click="NavSystemHealth_Click" 
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                       Padding="12,10" CornerRadius="8" Appearance="Secondary" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="❤️" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Sistem Sağlığı" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- 7. Sırada: Başlangıç Uygulamaları -->
                            <ui:Button x:Name="NavStartupAppsBtn" Click="NavStartupApps_Click" 
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                       Padding="12,10" CornerRadius="8" Appearance="Secondary" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚀" FontSize="15" Margin="0,0,10,0" />
                                    <TextBlock Text="Başlangıç Uygulamaları" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- 8. Sırada: Yazılım Güncelleyici -->
                            <ui:Button x:Name="NavSoftwareUpdaterBtn" Click="NavSoftwareUpdater_Click" 
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                       Padding="12,10" CornerRadius="8" Appearance="Secondary" Margin="0,0,0,6">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="📦" FontSize="15" Margin="0,0,10,0" />
                                        <TextBlock Text="Yazılım Güncelleyici" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border x:Name="NavUpdateBadge" Grid.Column="1" Background="#10B981" CornerRadius="10" Padding="6,1" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="NavUpdateBadgeText" Text="0" FontSize="10" FontWeight="Bold" Foreground="#041F14" />
                                    </Border>
                                </Grid>
                            </ui:Button>

                            <!-- 9. Sırada: Oyun ve Performans -->
                            <ui:Button x:Name="NavGamePerfBtn" Click="NavGamePerf_Click" 
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                       Padding="12,10" CornerRadius="8" Appearance="Secondary" Margin="0,0,0,6">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="🎮" FontSize="15" Margin="0,0,10,0" />
                                        <TextBlock Text="Oyun ve Performans" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border x:Name="NavGameBadge" Grid.Column="1" Background="#6366F1" CornerRadius="10" Padding="6,1" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock x:Name="NavGameBadgeText" Text="0" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </Border>
                                </Grid>
                            </ui:Button>

                            <!-- 10. Sırada: Tweak Kontrol -->
                            <ui:Button x:Name="NavTweakAuditBtn" Click="NavTweakAudit_Click"
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                       Padding="12,10" CornerRadius="8" Appearance="Secondary" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧩" FontSize="15" Margin="0,0,10,0" />
                                    <TextBlock Text="Tweak Kontrol" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- 3. Grup: Ağ & Araçlar -->
                            <TextBlock Text="Ağ &amp; Araçlar" FontSize="11" FontWeight="Bold" 
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="8,16,0,10" />

                            <!-- Başlatıcı: Ağ & DNS Merkezi (nav değil, ayrı pencere açar) -->
                            <ui:Button x:Name="NavNetworkDnsBtn" Click="NavNetworkDns_Click"
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                       Padding="12,10" CornerRadius="8" Appearance="Secondary" Margin="0,0,0,6"
                                       ToolTip="Ağ &amp; DNS Merkezi'ni ayrı pencerede açar">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="15" Margin="0,0,10,0" />
                                    <TextBlock Text="Ağ &amp; DNS Merkezi" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Alt Sistem & Donanım Bilgisi Kartı (Tıklanabilir) -->
                    <Border x:Name="SystemStatusCard" Grid.Row="1" 
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,10,0,4"
                            Cursor="Hand" MouseLeftButtonDown="SystemStatusCard_Click"
                            ToolTip="Sistem ve donanım kimliğini görüntülemek için tıklayın">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                        <Setter Property="BorderBrush" Value="#6366F1" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="SİSTEM &amp; DONANIM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="ℹ️" HorizontalAlignment="Right" FontSize="10" Foreground="#6366F1" />
                            </Grid>
                            <TextBlock x:Name="CardOsText" Text="Windows 11" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse x:Name="CardStatusDot" Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="CardStatusText" Text="Etkinleştirildi" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Telif -->
                    <TextBlock Grid.Row="2" Text="© 2026 hcorc (PureWin Project)" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
            </Border>

            <!-- SAĞ İÇERİK ALANI -->
            <Grid Grid.Column="1">
                
                <!-- 1. GÖRÜNÜM: BLOATWARE KALDIRICI -->
                <Grid x:Name="ViewBloatware" Visibility="Collapsed" Margin="24,16,24,90">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Başlık ve Hızlı Seçim Butonları -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🗑️ Bloatware Kaldırıcı" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="BloatwareSubtitle" Text="Windows ile gelen gereksiz UWP paketlerini kalıntısız temizleyin. Canlı tarama sadece sisteminizde olanları gösterir." 
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Content="🛡️ Güvenlileri Seç" Click="SelectSafeApps_Click" Appearance="Secondary" Padding="11,6" Margin="0,0,8,0" />
                                <ui:Button Content="☑️ Tümünü Seç" Click="SelectAllApps_Click" Appearance="Secondary" Padding="11,6" Margin="0,0,8,0" />
                                <ui:Button Content="🔄 Temizle" Click="ClearAppSelection_Click" Appearance="Secondary" Padding="11,6" />
                            </StackPanel>
                        </Grid>

                        <!-- Filtreleme ve Canlı Paket Durumu Çubuğu -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" x:Name="FilterInstalledOnlyCheck" 
                                          Content="Yalnızca Bilgisayarımda Kurulu Olanları Göster" 
                                          IsChecked="False" Checked="FilterBloatware_Changed" Unchecked="FilterBloatware_Changed"
                                          FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1A3B82F6" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="6" Padding="8,2">
                                        <TextBlock x:Name="BloatwareCounterBadge" Text="Tarama yapılıyor..." FontSize="11" FontWeight="SemiBold" Foreground="#3B82F6" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- Temiz Sistem Durumu Bildirim Kartı (Kurulu paket olmadığında görünür) -->
                        <Border x:Name="CleanSystemCard" Visibility="Collapsed" Background="#1210B981" BorderBrush="#3310B981" 
                                BorderThickness="1" CornerRadius="12" Padding="28,24" VerticalAlignment="Top" Margin="0,10,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🛡️" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                <TextBlock Text="Tebrikler! Sisteminiz Zaten Tertemiz" FontSize="17" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" />
                                <TextBlock Text="Bilgisayarınızda bilinen gereksiz Windows UWP bloatware paketlerinin hiçbiri tespit edilmedi. Sisteminizde temizlenecek kalıntı bulunmuyor." 
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" />
                                <ui:Button Content="📋 Tüm Bloatware Kataloğunu İncele" Click="ShowAllCatalog_Click" Appearance="Secondary" HorizontalAlignment="Center" Margin="0,16,0,0" Padding="14,7" />
                            </StackPanel>
                        </Border>

                        <!-- Uygulama Listesi (Kaydırma çubuğu her zaman görünür) -->
                        <ScrollViewer x:Name="BloatwareScrollViewer" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl x:Name="BloatwareList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                                                Opacity="{Binding IsInstalled, Converter={local:InstalledOpacityConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding IsInstalled}"
                                                          Checked="OnBloatwareCheckChanged" Unchecked="OnBloatwareCheckChanged"
                                                          VerticalAlignment="Center" Margin="0,0,14,0" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" 
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                                        <Border Background="#1A0284C7" BorderBrush="#330284C7" BorderThickness="1" CornerRadius="6" Padding="6,1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AppId}" FontSize="10" FontFamily="Consolas" Foreground="#0284C7" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Canlı Kurulum Durumu Rozeti -->
                                                    <Border CornerRadius="6" Padding="8,2" Margin="0,0,8,0"
                                                            Background="{Binding IsInstalled, Converter={local:InstalledBadgeBackgroundConverter}}"
                                                            BorderBrush="{Binding IsInstalled, Converter={local:InstalledBadgeBorderConverter}}" BorderThickness="1">
                                                        <TextBlock Text="{Binding IsInstalled, Converter={local:InstalledBadgeTextConverter}}" 
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding IsInstalled, Converter={local:InstalledBadgeForegroundConverter}}" />
                                                    </Border>

                                                    <!-- Güvenlik Rozeti -->
                                                    <Border CornerRadius="6" Padding="8,2"
                                                            Background="{Binding IsSafe, Converter={local:SafeBadgeBackgroundConverter}}"
                                                            BorderBrush="{Binding IsSafe, Converter={local:SafeBadgeBorderConverter}}" BorderThickness="1">
                                                        <TextBlock Text="{Binding IsSafe, Converter={local:SafeBadgeTextConverter}}" 
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding IsSafe, Converter={local:SafeBadgeForegroundConverter}}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 2. GÖRÜNÜM: SİSTEM İNCE AYARLARI (MODERN WINDOWS 11 FLUENT AKIŞI) -->
                <Grid x:Name="ViewTweaks" Visibility="Collapsed" Margin="24,16,24,90">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="⚙️ Sistem İnce Ayarları" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Windows 11 deneyiminizi kişiselleştirin, gereksiz arka plan hizmetlerini ve telemetriyi açma/kapama anahtarlarıyla yönetin." 
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Ferah Dikey Akış (Yatay kaydırma kapalı, toggle'lar ve menüler sağa sabit) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="CategoriesList" Margin="0,0,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,24">
                                        <!-- Kategori Başlığı -->
                                        <Border Margin="0,6,0,10" Padding="2,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Kategorinin Altındaki Ayar Satırları -->
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1" CornerRadius="8"
                                                            Padding="16,13" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Sol Taraf: Başlık ve Açıklama -->
                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" 
                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Description}" FontSize="11.5" 
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                                           Margin="0,3,0,0" TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <!-- Sağ Taraf: Doğrulandı Rozeti + ToggleSwitch / ComboBox -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Canlı Doğrulandı Rozeti -->
                                                                <Border Visibility="{Binding IsVerified, Converter={local:BooleanToVisibilityConverter}}"
                                                                        Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1"
                                                                        CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                        ToolTip="{Binding VerificationTooltipText}">
                                                                    <TextBlock Text="✓ Doğrulandı" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                                                                </Border>

                                                                <!-- Opsiyonel Hızlı Eylem Butonu (Örn: Masaüstü Simge Ayarlarını Aç) -->
                                                                <ui:Button Content="{Binding ActionButtonText}"
                                                                           ToolTip="{Binding ActionButtonToolTip}"
                                                                           Click="TweakActionButton_Click"
                                                                           Tag="{Binding}"
                                                                           Appearance="Secondary"
                                                                           Padding="9,4" FontSize="11" Margin="0,0,10,0"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="{Binding HasActionButton, Converter={local:BooleanToVisibilityConverter}}" />

                                                                <!-- 1. TOGGLESWITCH (Standart Ayarlar) -->
                                                                <ui:ToggleSwitch IsChecked="{Binding IsPendingChecked, Mode=TwoWay}"
                                                                                 Checked="OnTweakToggleChanged" Unchecked="OnTweakToggleChanged"
                                                                                 OnContent="" OffContent=""
                                                                                 VerticalAlignment="Center">
                                                                    <ui:ToggleSwitch.Style>
                                                                        <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDropdown}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ui:ToggleSwitch.Style>
                                                                </ui:ToggleSwitch>

                                                                <!-- 2. DROPDOWN (Çok Seçenekli Ayarlar) -->
                                                                <ComboBox ItemsSource="{Binding DropdownOptions}"
                                                                          SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                                                          SelectionChanged="OnDropdownSelectionChanged"
                                                                          DisplayMemberPath="Label"
                                                                          Width="220" VerticalAlignment="Center">
                                                                    <ComboBox.Style>
                                                                        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDropdown}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ComboBox.Style>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 3. GÖRÜNÜM: WINDOWS SERVİSLERİ (HİZMETLER) -->
                <Grid x:Name="ViewServices" Visibility="Collapsed" Margin="24,14,24,90">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Başlık ve Hızlı Seçim Butonları -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🛠️ Windows Servisleri (Hizmetler)" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Arka planda RAM ve CPU tüketen gereksiz Windows servislerini devre dışı bırakın." 
                                           FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Content="🛡️ Güvenlileri Seç" Click="SelectSafeServices_Click" Appearance="Secondary" Padding="9,4" Margin="0,0,6,0" FontSize="11" />
                                <ui:Button Content="☑️ Tümünü Seç" Click="SelectAllServices_Click" Appearance="Secondary" Padding="9,4" Margin="0,0,6,0" FontSize="11" />
                                <ui:Button Content="🔄 Temizle" Click="ClearServiceSelection_Click" Appearance="Secondary" Padding="9,4" Margin="0,0,6,0" FontSize="11" />
                                <ui:Button x:Name="BtnEnableAllDisabled" Content="⚡ Kapalıları Geri Aç / Başlat" Click="EnableAllDisabledServices_Click" Appearance="Secondary" Padding="9,4" FontSize="11" ToolTip="Devre dışı veya durdurulmuş servisleri yeniden etkinleştirir ve başlatır" />
                            </StackPanel>
                        </Grid>

                        <!-- Arama ve Filtreleme Çubuğu (Sade & Derli Toplu) -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Arama Kutusu -->
                                <ui:TextBox Grid.Column="0" x:Name="ServiceSearchBox" PlaceholderText="🔍 Servis ara..." 
                                            TextChanged="ServiceSearch_TextChanged" VerticalAlignment="Center" Margin="0,0,10,0" Padding="6,3" FontSize="11" />

                                <!-- Filtre Butonları -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="FilterAllServicesRadio" Content="Tümü (44)" IsChecked="True" 
                                                 Checked="ServiceFilter_Changed" Margin="0,0,12,0" FontWeight="SemiBold" FontSize="11" />
                                    <RadioButton x:Name="FilterSafeServicesRadio" Content="🛡️ Güvenli (34)" 
                                                 Checked="ServiceFilter_Changed" Margin="0,0,12,0" FontWeight="SemiBold" FontSize="11" />
                                    <RadioButton x:Name="FilterOptionalServicesRadio" Content="⚠️ İsteğe Bağlı (10)" 
                                                 Checked="ServiceFilter_Changed" Margin="0,0,12,0" FontWeight="SemiBold" FontSize="11" />
                                    <RadioButton x:Name="FilterDisabledServicesRadio" Content="🚫 Durdurulmuş / Kapalı" 
                                                 Checked="ServiceFilter_Changed" FontWeight="SemiBold" FontSize="11" />
                                </StackPanel>

                                <!-- Sayaç Rozeti -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1A3B82F6" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="ServicesCounterBadge" Text="44 Servis" FontSize="10" FontWeight="SemiBold" Foreground="#3B82F6" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Sadeleştirilmiş ve Daraltılmış Servis Kartları Listesi -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl x:Name="ServicesList" AutomationProperties.Name="Windows Servisleri Listesi">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,0,3"
                                            AutomationProperties.Name="{Binding DisplayName}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Sol: CheckBox -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Checked="ServiceToggle_Changed" Unchecked="ServiceToggle_Changed" 
                                                      VerticalAlignment="Center" Margin="0,0,10,0"
                                                      AutomationProperties.Name="{Binding DisplayName}" />

                                            <!-- Orta: Bilgi & Rozetler (Daraltılmış ve Sade) -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" 
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,5,0" />
                                                    
                                                    <TextBlock Text="{Binding ServiceName, StringFormat='({0})'}" FontSize="10" 
                                                               FontFamily="Consolas" Foreground="{DynamicResource TextFillColorTertiaryBrush}" 
                                                               VerticalAlignment="Center" Margin="0,0,6,0" />

                                                    <!-- İsteğe Bağlı Sarı Uyarı Rozeti -->
                                                    <Border Background="#22F59E0B" BorderBrush="#44F59E0B" BorderThickness="1" CornerRadius="4" Padding="5,1" 
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding WarningText, Converter={local:StringNotNullToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding WarningText}" Foreground="#F59E0B" FontSize="9.5" FontWeight="SemiBold" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Sade Açıklama -->
                                                <TextBlock Text="{Binding Description}" FontSize="10.5" 
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                            </StackPanel>

                                            <!-- Sağ: Canlı Durum Rozeti ve Tek Tıkla Geri Aç / Başlat Butonu -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Border CornerRadius="4" Padding="7,2" Background="#151E293B" BorderBrush="#3364748B" BorderThickness="1" 
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" 
                                                               FontSize="10" FontWeight="SemiBold" />
                                                </Border>

                                                <ui:Button Content="{Binding ActionButtonText}" Click="EnableSingleService_Click" Tag="{Binding}"
                                                           Appearance="Secondary" Padding="7,2" FontSize="10" Margin="6,0,0,0"
                                                           Visibility="{Binding CanStartOrEnable, Converter={local:BooleanToVisibilityConverter}}"
                                                           AutomationProperties.Name="{Binding ActionButtonText}"
                                                           ToolTip="Bu servisi etkinleştir ve hemen başlat" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 4. GÖRÜNÜM: SİSTEM SAĞLIK RAPORU & KARNE -->
                <Grid x:Name="ViewReport" Visibility="Visible" Margin="24,16,24,90">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Başlık & Yenileme Butonu -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📊 Sistem Optimizasyon ve Sağlık Raporu" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Windows 11 sisteminizdeki doğrulanmış ayarların ve temizlik durumunun canlı karnesi." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="🔄 Raporu Güncelle" Click="RefreshReport_Click" Appearance="Secondary" Padding="12,7" Margin="0,0,8,0" />
                            <ui:Button Content="📄 HTML Raporu Al" Click="ExportHtmlReport_Click" Appearance="Primary" Padding="14,7" />
                        </StackPanel>
                    </Grid>

                    <!-- Rapor Kartları (Scroll edilebilir) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <!-- Büyük Genel Skor Kartı -->
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="20" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="GENEL OPTİMİZASYON PUANI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock x:Name="ReportScoreText" Text="%85" FontSize="34" FontWeight="Bold" Foreground="#10B981" />
                                            <TextBlock Text=" Optimize Edildi" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Bottom" Margin="8,0,0,6" />
                                        </StackPanel>
                                        <TextBlock x:Name="ReportSummaryText" Text="Sisteminizdeki 67 ince ayardan ve 132 bloatware paketinden alınan canlı veriler." FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border x:Name="ReportBadgeBorder" Grid.Column="1" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
                                        <TextBlock x:Name="ReportBadgeText" Text="🛡️ Sistem Korumada" FontWeight="Bold" FontSize="13" Foreground="#10B981" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 4 Adet Detay Kartı (2x2 Grid) -->
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <!-- 1. Gizlilik & Telemetri -->
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="16" Margin="0,0,8,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔒" FontSize="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Gizlilik &amp; Telemetri" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="ReportTelemetryStatus" Text="● Telemetri Görevleri: Kontrol Ediliyor" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" Margin="0,8,0,0" />
                                        <TextBlock Text="Windows izleyicileri, hata raporlama ve anket görevleri durdurulur." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- 2. Görsel Hız & Efektler -->
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="16" Margin="8,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" FontSize="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Görsel Hız &amp; Efektler" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="ReportVisualStatus" Text="● Görsel Ayarlar: Doğrulandı" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" Margin="0,8,0,0" />
                                        <TextBlock Text="Pencere animasyonları, şeffaflık ve GPU yükü optimize edilir." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- 3. Yapay Zeka & İzleyiciler -->
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🤖" FontSize="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Yapay Zeka (AI) İzleyicileri" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="ReportAIStatus" Text="● Copilot &amp; Recall: Kontrol Ediliyor" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" Margin="0,8,0,0" />
                                        <TextBlock Text="Ekran kaydı alan Recall ve arka plan AI servisleri engellenir." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- 4. Bloatware Durumu -->
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🗑️" FontSize="16" Margin="0,0,8,0" />
                                            <TextBlock Text="Bloatware &amp; Temizlik" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="ReportBloatwareStatus" Text="● Kurulu Çöp Paket: Hesaplanıyor" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" Margin="0,8,0,0" />
                                        <TextBlock x:Name="ReportBloatwareDesc" Text="Sistemde gereksiz disk ve RAM tüketen UWP paketlerinin temizlik durumu." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Kritik Telemetri ve Gizlilik Röntgeni (Canlı Snapshot Tablosu) -->
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="🔬 Kritik Telemetri ve Gizlilik Röntgeni (Canlı Durum)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="Windows'un en kritik arka plan casus, telemetri ve izleyici bileşenlerinin o anki doğrulanmış durumu." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                            <TextBlock Text="● Canlı Snapshot" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                                        </Border>
                                    </Grid>

                                    <!-- Röntgen Satırları -->
                                    <StackPanel>
                                        <!-- 1. DiagTrack -->
                                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="DiagTrack (Bağlı Kullanıcı Deneyimleri ve Telemetrisi)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="Kullanım alışkanlıkları ve sistem tanılama verilerini Microsoft'a aktarır." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <TextBlock x:Name="XrayDiagTrackDesc" Grid.Column="1" Text="Kontrol ediliyor..." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                                <Border x:Name="XrayDiagTrackBadge" Grid.Column="2" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock x:Name="XrayDiagTrackStatus" Text="Devre Dışı" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 2. WerSvc -->
                                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Windows Hata Raporlama Hizmeti (WerSvc)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="Uygulama çökmelerinde kilitlenme günlüklerini dış sunuculara gönderir." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <TextBlock x:Name="XrayWerSvcDesc" Grid.Column="1" Text="Kontrol ediliyor..." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                                <Border x:Name="XrayWerSvcBadge" Grid.Column="2" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock x:Name="XrayWerSvcStatus" Text="Devre Dışı" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 3. Zamanlanmış Telemetri Görevleri -->
                                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Zamanlanmış Telemetri Görevleri (17 Temel Görev)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="Appraiser, UsbCeip, Consolidator ve müşteri deneyimi arka plan tarayıcıları." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <TextBlock x:Name="XrayTasksDesc" Grid.Column="1" Text="Kontrol ediliyor..." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                                <Border x:Name="XrayTasksBadge" Grid.Column="2" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock x:Name="XrayTasksStatus" Text="Durduruldu" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 4. Tarayıcı Arka Plan Çalışması -->
                                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Tarayıcı Arka Plan Modu &amp; Başlangıç Hızlandırması" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="Edge, Chrome, Brave ve Opera GX kapalıyken RAM ve CPU tüketimini engeller." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <TextBlock x:Name="XrayBrowserDesc" Grid.Column="1" Text="Kontrol ediliyor..." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                                <Border x:Name="XrayBrowserBadge" Grid.Column="2" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock x:Name="XrayBrowserStatus" Text="Engellendi" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 5. Yapay Zeka (AI / Copilot) -->
                                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Windows Copilot &amp; Recall AI Entegrasyonu" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="Görev çubuğu AI düğmeleri ve ekran geçmişi kayıt motorunu denetler." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <TextBlock x:Name="XrayAiDesc" Grid.Column="1" Text="Kontrol ediliyor..." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                                <Border x:Name="XrayAiBadge" Grid.Column="2" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock x:Name="XrayAiStatus" Text="Devre Dışı" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 6. Windows Arama Dizinlemesi (WSearch) -->
                                        <Border Padding="0,10,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="Windows Search (Dosya &amp; Başlat Arama Dizinlemesi)" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="Arka planda disk indekslemesi yapar (SSD/HDD ömrü ve disk performansı)." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <TextBlock x:Name="XraySearchDesc" Grid.Column="1" Text="Kontrol ediliyor..." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0" />
                                                <Border x:Name="XraySearchBadge" Grid.Column="2" Background="#1AF59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock x:Name="XraySearchStatus" Text="Çalışıyor" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 5. GÖRÜNÜM: SİSTEM TEMİZLİĞİ -->
                <Grid x:Name="ViewCleanup" Visibility="Collapsed" Margin="24,16,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Başlık ve Hızlı Eylem Butonları (Responsive Düzen) -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 1. Satır: Başlık ve Açıklama -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="🧹 Sistem Temizliği" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Gereksiz sistem artıklarını ve geçici dosyaları temizleyerek depolama alanı açın." 
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- 2. Satır: Eylem Butonları (WrapPanel: Dar ekranlarda asla üst üste binmez) -->
                            <WrapPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="ScanCleanupBtn" Content="🔍 Sistemi Tara" Click="ScanCleanup_Click" 
                                           Appearance="Secondary" Padding="13,7" Margin="0,0,8,6" FontWeight="SemiBold" />
                                <ui:Button x:Name="ExecuteCleanupBtn" Content="🧹 Seçilenleri Temizle" Click="ExecuteCleanup_Click" 
                                           Appearance="Primary" Padding="15,7" Margin="0,0,8,6" FontWeight="Bold" />
                                <ui:Button x:Name="SelectSafeCleanupBtn" Content="🛡️ Güvenli Seç" Click="SelectSafeCleanup_Click" 
                                           Appearance="Secondary" Padding="12,7" Margin="0,0,8,6" FontWeight="SemiBold" />
                                <ui:Button x:Name="SelectAllCleanupBtn" Content="☑️ Tümünü Seç" Click="SelectAllCleanup_Click" 
                                           Appearance="Secondary" Padding="12,7" Margin="0,0,8,6" />
                                <ui:Button x:Name="DeselectAllCleanupBtn" Content="Seçimi Kaldır" Click="DeselectAllCleanup_Click" 
                                           Appearance="Secondary" Padding="12,7" Margin="0,0,0,6">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="DismissSquare24" FontSize="14" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </WrapPanel>
                        </Grid>

                        <!-- Özet Kartı ve Entegre İlerleme Göstergesi -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                                CornerRadius="8" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Bilgi Rozetleri -->
                                <Grid Grid.Row="0" Margin="14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Bulunan Toplam Alan -->
                                        <Border Background="#1A3B82F6" BorderBrush="#333B82F6" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                            <TextBlock x:Name="CleanupScannedBadge" Text="Toplam Taranan: Henüz Taranmadı" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" />
                                        </Border>
                                        <!-- Seçilen Alan -->
                                        <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                                            <TextBlock x:Name="CleanupSelectedBadge" Text="Seçilen Alan: 0 B" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                        </Border>
                                        <!-- Durum -->
                                        <Border Background="#1AF59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                            <TextBlock x:Name="CleanupStatusBadge" Text="● Beklemede (Önce Tara)" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock x:Name="CleanupCategoriesCountText" Grid.Column="1" Text="40 Temizlik Kalemi" FontSize="11" 
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Kartın Tabanına Entegre Akıcı Zümrüt İlerleme Çubuğu -->
                                <ProgressBar x:Name="CleanupProgressBar" Grid.Row="1" Height="3.5" 
                                             Foreground="#10B981" Background="#2610B981" BorderThickness="0" 
                                             Visibility="Collapsed" IsIndeterminate="True" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Genişletilebilir Kategori & Alt Maddeler Listesi -->
                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl x:Name="CleanupGroupsList" Margin="0,0,12,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                            <StackPanel>
                                                <!-- 1. KATEGORİ BAŞLIK SATIRI (EXPANDER HEADER) -->
                                                <Border Background="Transparent" Padding="14,11" Cursor="Hand"
                                                        MouseLeftButtonUp="OnGroupHeaderClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Sol: Aç/Kapa Oku (Chevron), CheckBox, İkon ve Başlık -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Aç/Kapa Oku -->
                                                            <TextBlock Text="{Binding ChevronIcon}" FontSize="12" FontWeight="Bold" 
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                                       VerticalAlignment="Center" Width="18" TextAlignment="Center" Margin="0,0,6,0" />

                                                            <!-- Ana Checkbox (Tek tıkla aç/kapat, alt maddeler karışıksa [-] gösterir) -->
                                                            <CheckBox IsThreeState="False" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      VerticalAlignment="Center" Margin="0,0,12,0" />

                                                            <!-- Kategori İkonu -->
                                                            <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />

                                                            <!-- Kategori Başlığı -->
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" 
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <!-- Sağ: Grup Toplam Boyut Rozeti ve Durum -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- Grup Toplam Boyut (Mavi) -->
                                                            <Border Background="#1A3B82F6" BorderBrush="#333B82F6" BorderThickness="1" 
                                                                    CornerRadius="6" Padding="10,4" Margin="0,0,8,0" MinWidth="85">
                                                                <TextBlock Text="{Binding DisplayTotalSize}" FontWeight="Bold" FontSize="11.5" 
                                                                           Foreground="#3B82F6" HorizontalAlignment="Center" />
                                                            </Border>

                                                            <!-- Grup Durumu (Yeşil / Mavi) -->
                                                            <Border Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}" BorderThickness="1" 
                                                                    CornerRadius="6" Padding="10,4" MinWidth="85">
                                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11" 
                                                                           Foreground="{Binding StatusForeground}" HorizontalAlignment="Center" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- 2. ALT MADDELER LİSTESİ (AÇILIP KAPANAN İÇERİK) -->
                                                <StackPanel Visibility="{Binding IsExpanded, Converter={local:BooleanToVisibilityConverter}}">
                                                    <!-- İnce Ayırıcı Çizgi -->
                                                    <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="12,0,12,6" />

                                                    <ItemsControl ItemsSource="{Binding Items}" Margin="12,0,12,8">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="#06FFFFFF" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                                        BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,5">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Alt Madde Checkbox ve İkon -->
                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                            <Image Source="{Binding IconImage}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                                   Visibility="{Binding HasIconImage, Converter={local:BooleanToVisibilityConverter}}"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                                        </StackPanel>

                                                                        <!-- Alt Madde Başlığı ve Açıklaması -->
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" 
                                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                                                                <Border Visibility="{Binding RiskyBadgeVisibility}" 
                                                                                        Background="#1AE11D48" BorderBrush="#33E11D48" BorderThickness="1" 
                                                                                        CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="⚠️ Riskli" FontWeight="Bold" FontSize="10" Foreground="#F43F5E" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding Description}" FontSize="11" 
                                                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                                        </StackPanel>

                                                                        <!-- Alt Madde Boyut ve Durum Rozeti -->
                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <!-- Boyut Rozeti (Mavi) -->
                                                                            <Border Background="#1A3B82F6" BorderBrush="#333B82F6" BorderThickness="1" 
                                                                                    CornerRadius="5" Padding="8,3" Margin="0,0,6,0" MinWidth="75">
                                                                                <TextBlock Text="{Binding DisplaySize}" FontWeight="Bold" FontSize="11" 
                                                                                           Foreground="#3B82F6" HorizontalAlignment="Center" />
                                                                            </Border>

                                                                            <!-- Durum Rozeti (Yeşil / Mavi) -->
                                                                            <Border Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}" BorderThickness="1" 
                                                                                    CornerRadius="5" Padding="8,3" MinWidth="75">
                                                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="10.5" 
                                                                                           Foreground="{Binding StatusForeground}" HorizontalAlignment="Center" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 6. GÖRÜNÜM: SİSTEM SAĞLIĞI (KONSEPT 2: KOMPAKT LİSTE MODELİ) -->
                <Grid x:Name="ViewSystemHealth" Visibility="Collapsed" Margin="24,16,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Üst Başlık Alanı -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="❤️" FontFamily="Segoe UI Emoji" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Sistem Sağlığı ve Onarım" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Windows çekirdek dosyalarını, bileşen depolarını ve sistem bütünlüğünü denetleyin ve onarın." 
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- İçerik Akışı (Kategori Başlıkları ve Kompakt Liste Kartları) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SystemHealthCategoriesList" Margin="0,0,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,24">
                                        <!-- Kategori Başlığı -->
                                        <Border Margin="0,6,0,10" Padding="2,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Icon}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Kategorinin Altındaki Sağlık Maddeleri -->
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1" CornerRadius="8"
                                                            Padding="16,14" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <!-- Üst Satır: Başlık, Açıklama, Komut ve Sağ Aksiyon Butonları -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Sol Taraf: Başlık, Açıklama, Komut Bilgisi -->
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" 
                                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                                                    
                                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" 
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                                               Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="17" />

                                                                    <!-- Minimal Komut / Yöntem Kutusu -->
                                                                    <Border Background="#14000000" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" 
                                                                            BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,8,0,0" HorizontalAlignment="Left">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="Komut: " FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding CommandInfo}" FontFamily="Consolas, Segoe UI Mono" FontSize="10.5" 
                                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Sağ Taraf: Rozetler ve Eylem Butonu -->
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <!-- Risk Rozeti (Düşük riskte gizli; Düşük-Orta/Orta turuncu, Yüksek kırmızı görünür) -->
                                                                    <Border Visibility="{Binding HasRiskBadge, Converter={local:BooleanToVisibilityConverter}}"
                                                                            Background="{Binding RiskBackground}" BorderBrush="{Binding RiskBorder}" BorderThickness="1"
                                                                            CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding RiskBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RiskForeground}" />
                                                                    </Border>

                                                                    <!-- Sonuç / Çalışma Durum Rozeti -->
                                                                    <Border Visibility="{Binding HasResultBadge, Converter={local:BooleanToVisibilityConverter}}"
                                                                            Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}" BorderThickness="1"
                                                                            CornerRadius="4" Padding="7,3" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusForeground}" />
                                                                    </Border>

                                                                    <!-- Eylem Butonu -->
                                                                    <ui:Button Content="{Binding ActionButtonText}" 
                                                                               Click="HealthAction_Click"
                                                                               Tag="{Binding}"
                                                                               Appearance="{Binding ActionButtonAppearance}"
                                                                               IsEnabled="{Binding IsActionEnabled}"
                                                                               Padding="14,7" FontSize="12" FontWeight="SemiBold"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- CANLI İLERLEME ÇUBUĞU VE AŞAMA ALANI -->
                                                            <StackPanel Visibility="{Binding ShowProgressBar, Converter={local:BooleanToVisibilityConverter}}" 
                                                                        Margin="0,12,0,0">
                                                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,10" />

                                                                <Grid Margin="0,0,0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding StageText}" FontSize="11.5" FontWeight="SemiBold" 
                                                                               Foreground="{Binding StatusForeground}" TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="11.5" FontWeight="Bold" 
                                                                               FontFamily="Consolas, Segoe UI Mono" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="8,0,0,0" />
                                                                </Grid>

                                                                <!-- Akıcı Windows 11 Fluent İlerleme Çubuğu -->
                                                                <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="5" 
                                                                             Foreground="{Binding ProgressForeground}" Background="#1F808080" BorderThickness="0">
                                                                    <ProgressBar.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="2.5" />
                                                                        </Style>
                                                                    </ProgressBar.Resources>
                                                                </ProgressBar>
                                                            </StackPanel>

                                                            <!-- Sonuç / Durum Açıklama Metni (Sonuç alındığında) -->
                                                            <TextBlock Text="{Binding StatusDetail}" FontSize="11" FontWeight="Medium"
                                                                       Foreground="{Binding StatusForeground}" 
                                                                       Visibility="{Binding HasStatusDetail, Converter={local:BooleanToVisibilityConverter}}"
                                                                       Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="17" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 7. GÖRÜNÜM: BAŞLANGIÇ UYGULAMALARI (STARTUP APPS) -->
                <Grid x:Name="ViewStartupApps" Visibility="Collapsed" Margin="24,16,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 1. Üst Başlık Alanı -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="🚀 Başlangıç Uygulamaları" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Windows açılışında otomatik başlayan programları yönetin ve sistem açılış süresini optimize edin." 
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- 2. Üçlü İstatistik & BIOS Paneli (Kompakt WinUI 3 Düzeni) -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Kart 1: Son BIOS Zamanı -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="#4D3B82F6" BorderThickness="1" CornerRadius="8" Padding="14,9">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="⚡ SON BIOS ZAMANI" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="● Aktif" FontSize="10.5" FontWeight="SemiBold" Foreground="#60A5FA" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock x:Name="TxtStartupBiosTime" Text="-- Saniye" FontSize="17" FontWeight="Bold" Foreground="#60A5FA" Margin="0,1,0,2" />
                                <TextBlock Text="Donanım ve bellenim (POST) başlatma hızı" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- Kart 2: Başlangıç Durumu -->
                        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,9">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="📊 BAŞLANGIÇ DURUMU" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Kayıtlı" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock x:Name="TxtStartupStatusCounts" Text="0 / 0 Etkin" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,1,0,2" />
                                <TextBlock x:Name="TxtStartupActiveSummary" Text="0 program açılışta otomatik başlıyor" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- Kart 3: Başlangıç Yükü -->
                        <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,9">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="⚠️ BAŞLANGIÇ YÜKÜ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtStartupLoadLevelBadge" Text="Normal" FontSize="10.5" FontWeight="SemiBold" Foreground="#FBBF24" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock x:Name="TxtStartupHighImpactCount" Text="0 Yüksek Etki" FontSize="17" FontWeight="Bold" Foreground="#FBBF24" Margin="0,1,0,2" />
                                <TextBlock Text="Gereksiz olanları kapatıp açılışı hızlandırın" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 3. Filtreleme, Arama ve Yenileme Çubuğu -->
                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Arama Kutusu -->
                        <ui:TextBox Grid.Column="0" x:Name="StartupSearchBox" PlaceholderText="🔍 Uygulama, yayıncı veya dosya yolu ara..." 
                                    TextChanged="StartupSearchBox_TextChanged" VerticalAlignment="Center" Padding="8,6" FontSize="12" />

                        <!-- Filtre Butonları -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <ui:Button x:Name="FilterStartupAllBtn" Content="Tümü (0)" Click="FilterStartup_Click" Tag="all" Appearance="Primary" Padding="12,6" Margin="0,0,6,0" CornerRadius="6" />
                            <ui:Button x:Name="FilterStartupEnabledBtn" Content="Etkin (0)" Click="FilterStartup_Click" Tag="enabled" Appearance="Secondary" Padding="12,6" Margin="0,0,6,0" CornerRadius="6" />
                            <ui:Button x:Name="FilterStartupDisabledBtn" Content="Devre Dışı (0)" Click="FilterStartup_Click" Tag="disabled" Appearance="Secondary" Padding="12,6" Margin="0,0,6,0" CornerRadius="6" />
                            <ui:Button x:Name="FilterStartupHighImpactBtn" Content="Yüksek Etki (0)" Click="FilterStartup_Click" Tag="high" Appearance="Secondary" Padding="12,6" CornerRadius="6" />
                        </StackPanel>

                        <!-- Yenile Butonu -->
                        <ui:Button x:Name="StartupRefreshBtn" Grid.Column="3" Content="🔄 Yenile" Click="StartupRefresh_Click"
                                   Appearance="Secondary" Padding="14,6" CornerRadius="6" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 4. Başlangıç Uygulamaları Kart Listesi -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="StartupAppsList" Margin="0,0,8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Sol: Uygulama İkon Rozeti -->
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" 
                                                    Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                                                    Margin="0,0,14,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid>
                                                    <!-- Gerçek Exe İkonu Varsa -->
                                                    <Image Source="{Binding IconSource}" Width="24" Height="24"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding HasIconSource, Converter={local:BooleanToVisibilityConverter}}" />
                                                    <!-- Yoksa Kategori Emojisi -->
                                                    <TextBlock Text="{Binding FallbackIcon}" FontSize="18"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding HasIconSource, Converter={local:BooleanToInverseVisibilityConverter}}" />
                                                </Grid>
                                            </Border>

                                            <!-- Orta: Uygulama Başlığı (kaynak bilgisi tooltip'te), Dosya Konumu Butonu ve Yayıncı -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" 
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" 
                                                               TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center"
                                                               ToolTip="{Binding SourceDisplay}" />
                                                    <!-- Mini Dosya Konumunu Aç Butonu (WinUI 3 Nötr Akrilik Gümüş / Beyaz Stili) -->
                                                    <ui:Button Click="OpenAppLocation_Click" Tag="{Binding}" 
                                                               Padding="8,2" CornerRadius="5" Margin="8,0,0,0" 
                                                               Background="#18FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1"
                                                               ToolTip="Programın bulunduğu klasörü Windows Gezgini'nde aç" 
                                                               Visibility="{Binding CanOpenLocation, Converter={local:BooleanToVisibilityConverter}}" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="📁" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="Dosya Konumunu Aç" FontSize="11" FontWeight="SemiBold" Foreground="#F0F6FC" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ui:Button>
                                                </StackPanel>
                                                <!-- Alt Satır: Sadece Temiz Yayıncı Bilgisi (Uzun yollar gizlendi) -->
                                                <TextBlock Text="{Binding PublisherDisplay}" FontSize="12" 
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Sağ: Etki Rozeti + ToggleSwitch -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Başlangıç Etki Rozeti -->
                                                <Border Background="{Binding ImpactBadgeBackground}" 
                                                        BorderBrush="{Binding ImpactBadgeBorder}" 
                                                        BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ImpactDisplay}" FontSize="11" FontWeight="SemiBold" 
                                                               Foreground="{Binding ImpactBadgeForeground}" />
                                                </Border>

                                                <!-- Açma / Kapama ToggleSwitch -->
                                                <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                 Click="StartupAppToggle_Click"
                                                                 OnContent="Etkin" OffContent="Devre Dışı"
                                                                 VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- 8. GÖRÜNÜM: YAZILIM GÜNCELLEYİCİ (SOFTWARE UPDATER) -->
                <Grid x:Name="ViewSoftwareUpdater" Visibility="Collapsed" Margin="24,16,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 1. Üst Başlık ve Aksiyon Butonları Alanı -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Başlık ve Açıklama -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="📦 Yazılım Güncelleyici" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Windows Paket Yöneticisi (winget) ile kurulu programları tarayın, tek tıkla sessizce en güncel sürüme yükseltin." 
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Üst Butonlar -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="RefreshUpdatesBtn" Click="RefreshUpdates_Click"
                                       Appearance="Secondary" Padding="14,8" CornerRadius="6" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Yeniden Tara" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <ui:Button x:Name="UpdateAllBtn" Click="UpdateAll_Click"
                                       Appearance="Primary" Padding="16,8" CornerRadius="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="UpdateAllBtnText" Text="Tümünü Güncelle" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- 2. Zarif ve Kompakt 3'lü İstatistik Kartları (WinUI 3 Slim Cards) -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 1. Kart: Güncelleme Bekleyen Sayısı -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A10B981" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0">
                                    <TextBlock Text="📦" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatPendingUpdatesText" Text="Taranıyor..." FontSize="17" FontWeight="Bold" Foreground="#10B981" />
                                    <TextBlock Text="Güncelleme Bekliyor" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. Kart: Güvenli Altyapı Deposu -->
                        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A38BDF8" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0">
                                    <TextBlock Text="🛡️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Microsoft winget" FontSize="17" FontWeight="Bold" Foreground="#38BDF8" />
                                    <TextBlock Text="Güvenli Resmi Depo" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 3. Kart: Son Tarama Durumu -->
                        <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#18FFFFFF" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0">
                                    <TextBlock Text="🕒" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatLastScanText" Text="Henüz Yapılmadı" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Son Denetleme Durumu" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 3. Arama Çubuğu (Kategori hapları olmadan sade ve minimal) -->
                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:TextBox x:Name="SoftwareSearchBox" Grid.Column="0" 
                                    PlaceholderText="Kurulu uygulamalarda ara..." 
                                    TextChanged="SoftwareSearchBox_TextChanged"
                                    VerticalAlignment="Center" />

                        <TextBlock x:Name="SoftwareFilterStatusText" Grid.Column="2" 
                                   Text="0 güncelleme bulundu" 
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 4. İçerik Akışı (Yükleniyor / Boş Durum / Kartlar Listesi) -->
                    <Grid Grid.Row="3">
                        <!-- Yükleme / Tarama İlerleme Durumu -->
                        <Border x:Name="SoftwareLoadingState" Visibility="Collapsed" 
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="220" Height="4" Foreground="#10B981" Margin="0,0,0,14" />
                                <TextBlock Text="Kurulu programlar ve yeni sürümler taranıyor..." FontWeight="SemiBold" FontSize="13.5" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Windows Paket Yöneticisi (winget) veritabanı kontrol ediliyor, lütfen bekleyin." 
                                           FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Tüm Yazılımlar Güncel Durumu -->
                        <Border x:Name="SoftwareEmptyState" Visibility="Collapsed"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="32,24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🎉" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="Harika! Tüm Yazılımlarınız Güncel" FontWeight="Bold" FontSize="16" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Bilgisayarınızdaki desteklenen tüm uygulamalar en son sürümde çalışıyor." 
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- winget Bulunamadı Uyarısı -->
                        <Border x:Name="SoftwareMissingWingetWarning" Visibility="Collapsed"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚠️" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="Windows Paket Yöneticisi (winget) Bulunamadı" FontWeight="Bold" FontSize="15" 
                                           Foreground="#F59E0B" HorizontalAlignment="Center" />
                                <TextBlock Text="Bu özelliği kullanmak için Microsoft Store üzerinden 'Uygulama Yükleyicisi' (App Installer) paketinin kurulu olması gerekir." 
                                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Program Kartları Listesi -->
                        <ScrollViewer x:Name="SoftwareScrollViewer" Visibility="Visible" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="SoftwareUpdatesList" Margin="0,0,12,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Sol: Simge + Program Adı + Yayıncı/ID -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Simge Kutusu -->
                                                    <Border Width="38" Height="38" CornerRadius="8" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" Margin="0,0,12,0">
                                                        <Grid>
                                                            <Image Source="{Binding IconSource}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding HasIconSource, Converter={local:BooleanToVisibilityConverter}}" />
                                                            <TextBlock Text="{Binding FallbackIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding HasIconSource, Converter={local:BooleanToInverseVisibilityConverter}}" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Başlık ve Yayıncı Bilgileri -->
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" 
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                                        <TextBlock Text="{Binding DisplaySubInfo}" FontSize="11" 
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="430" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Orta: Sürüm Geçiş Kutusu (Eski ➔ Yeni) -->
                                                <Border Grid.Column="1" Background="#26000000" BorderBrush="#22FFFFFF" BorderThickness="1" 
                                                        CornerRadius="6" Padding="10,5" Margin="16,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CurrentVersion}" FontSize="11.5" 
                                                                   TextDecorations="Strikethrough" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="➔" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding AvailableVersion}" FontSize="12" FontWeight="Bold" 
                                                                   Foreground="#10B981" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Sağ: Güncelle Butonu / Canlı Durum / Rozet -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" MinWidth="130" HorizontalAlignment="Right">
                                                    <!-- Hazır Durum: Güncelle Butonu -->
                                                    <ui:Button Content="Güncelle" Click="UpdateSingleApp_Click" Tag="{Binding}"
                                                               Appearance="Secondary" Padding="14,6" CornerRadius="6" FontSize="12" FontWeight="SemiBold"
                                                               Visibility="{Binding IsReady, Converter={local:BooleanToVisibilityConverter}}" />

                                                    <!-- Güncelleniyor Durumu: İlerleme Çubuğu ve Yazı -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                Visibility="{Binding IsUpdating, Converter={local:BooleanToVisibilityConverter}}">
                                                        <ProgressBar IsIndeterminate="True" Width="70" Height="4" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="Yükleniyor..." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Tamamlandı Durumu: Yeşil 'Güncel' Rozeti -->
                                                    <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="6" Padding="8,4"
                                                            Visibility="{Binding IsCompleted, Converter={local:BooleanToVisibilityConverter}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="✓ " FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                                            <TextBlock Text="Güncel" FontSize="11.5" FontWeight="SemiBold" Foreground="#10B981" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Başarısız Durumu: Kırmızı Rozet + Tekrar Dene Butonu -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                Visibility="{Binding IsFailed, Converter={local:BooleanToVisibilityConverter}}">
                                                        <Border Background="#1AEF4444" BorderBrush="#33EF4444" BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,6,0">
                                                            <TextBlock Text="Başarısız" FontSize="10.5" Foreground="#EF4444" />
                                                        </Border>
                                                        <ui:Button Content="Tekrar Dene" Click="UpdateSingleApp_Click" Tag="{Binding}"
                                                                   Appearance="Secondary" Padding="8,4" CornerRadius="6" FontSize="11" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 9. GÖRÜNÜM: OYUN VE PERFORMANS (MODERN WINDOWS 11 FLUENT AKIŞI) -->
                <Grid x:Name="ViewGamePerf" Visibility="Collapsed" Margin="24,16,24,90">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 1. Başlık & Açıklama -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="🎮 Oyun ve Performans" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Oyunlarda gecikmeyi (input lag) düşürün, kararsız FPS dalgalanmalarını önleyin ve Windows donanım ayarlarını optimize edin." 
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- 2. Donanım Bilgi Şeridi (3 Akıllı Durum Kartı) -->
                    <Grid Grid.Row="1" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Kart 1: Monitör Hızı -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A3B82F6" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="🖥️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Monitör Hızı" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtMonitorHz" Text="-- Hz" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,1,0,0" />
                                    <TextBlock x:Name="TxtMonitorStatus" Text="Taranıyor..." FontSize="11" Foreground="#10B981" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Kart 2: Ağ Gecikmesi (Ping) -->
                        <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A10B981" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="📶" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Canlı Ağ Pingi" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtNetworkPing" Text="-- ms" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,1,0,0" />
                                    <TextBlock x:Name="TxtPingStatus" Text="Yaklaşık ağ gecikmesi" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ui:Button Grid.Column="2" x:Name="BtnRefreshPing" Click="BtnRefreshPing_Click"
                                           ToolTip="Ağ gecikmesini yeniden ölç"
                                           Appearance="Secondary" Padding="7,6" CornerRadius="6" VerticalAlignment="Center">
                                    <TextBlock Text="🔄" FontSize="12" />
                                </ui:Button>
                            </Grid>
                        </Border>

                        <!-- Kart 3: Aktif Güç Planı -->
                        <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1AF59E0B" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Aktif Güç Planı" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="TxtPowerPlanName" Text="Yükleniyor..." FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="TxtPowerPlanStatus" Text="Windows Güç Yönetimi" FontSize="11" Foreground="#3B82F6" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 3. Ayar Kartları Listesi (Önerilen ve İleri Düzey İki Ayrı Kategori Halinde) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,12,0">
                            
                            <!-- Kategori 1: Önerilen Oyun Ayarları -->
                            <Border Margin="0,4,0,8" Padding="2,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Önerilen Oyun Ayarları" FontSize="15" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Güvenli" FontSize="10.5" FontWeight="SemiBold" Foreground="#10B981" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="RecommendedGameTweaksList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="16,13" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Sol İkon Rozeti -->
                                                <Border Grid.Column="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Orta: Başlık, Rozet ve Açıklama -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" 
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                        
                                                        <Border Visibility="{Binding HasBadge, Converter={local:BooleanToVisibilityConverter}}"
                                                                Background="#1A3B82F6" BorderBrush="#333B82F6" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="#3B82F6" />
                                                        </Border>
                                                        
                                                        <Border Visibility="{Binding RequiresReboot, Converter={local:BooleanToVisibilityConverter}}"
                                                                Background="#1AF59E0B" BorderBrush="#33F59E0B" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="Yeniden Başlatma" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B" />
                                                        </Border>

                                                        <Border Visibility="{Binding IsNotSupported, Converter={local:BooleanToVisibilityConverter}}"
                                                                Background="#1AEF4444" BorderBrush="#33EF4444" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding UnsupportedReason}" FontSize="10" FontWeight="SemiBold" Foreground="#EF4444" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <!-- Sağ: ToggleSwitch -->
                                                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsPendingChecked, Mode=TwoWay}"
                                                                 IsEnabled="{Binding IsSupported}"
                                                                 Checked="OnGameTweakToggleChanged" Unchecked="OnGameTweakToggleChanged"
                                                                 OnContent="" OffContent=""
                                                                 VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Kategori 2: İleri Düzey & Ödünleşimli Ayarlar -->
                            <Border Margin="0,16,0,8" Padding="2,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="İleri Düzey &amp; Ödünleşimli Ayarlar" FontSize="15" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                    <Border Background="#1AF59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Ödünleşimli" FontSize="10.5" FontWeight="SemiBold" Foreground="#F59E0B" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <ItemsControl x:Name="AdvancedGameTweaksList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="16,13" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Sol İkon Rozeti -->
                                                <Border Grid.Column="0" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Orta: Başlık, Rozet ve Açıklama -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" 
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                        
                                                         <Border Visibility="{Binding HasBadge, Converter={local:BooleanToVisibilityConverter}}"
                                                                Background="#1AF59E0B" BorderBrush="#33F59E0B" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B" />
                                                        </Border>

                                                        <Border Visibility="{Binding IsNotSupported, Converter={local:BooleanToVisibilityConverter}}"
                                                                Background="#1AEF4444" BorderBrush="#33EF4444" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding UnsupportedReason}" FontSize="10" FontWeight="SemiBold" Foreground="#EF4444" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" 
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                                </StackPanel>

                                                <!-- Sağ: ToggleSwitch -->
                                                <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsPendingChecked, Mode=TwoWay}"
                                                                 IsEnabled="{Binding IsSupported}"
                                                                 Checked="OnGameTweakToggleChanged" Unchecked="OnGameTweakToggleChanged"
                                                                 OnContent="" OffContent=""
                                                                 VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 10. GÖRÜNÜM: TWEAK KONTROL (Güncelleme Sonrası Denetim, Salt Okunur) -->
                <Grid x:Name="ViewTweakAudit" Visibility="Collapsed" Margin="24,16,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🧩" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Tweak Kontrol" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Windows güncellemelerinden sonra ince ayarlarınızın hâlâ aktif olup olmadığını denetleyin. Bu sayfa salt okunurdur; hiçbir ayarı değiştirmez."
                                   FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,12,0">
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="18" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="SİSTEM AYARLARI DURUMU" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock x:Name="AuditActiveText" Text="0 Aktif" FontSize="20" FontWeight="Bold" Foreground="#10B981" />
                                            <TextBlock x:Name="AuditSuspectText" Text="0 Sıfırlanmış Olabilir" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#F59E0B" Margin="16,0,0,0" VerticalAlignment="Bottom" />
                                            <TextBlock x:Name="AuditOtherText" Text="0 Diğer" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="16,0,0,0" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                        <TextBlock x:Name="AuditLastScanText" Text="Son doğrulama: uygulama açılışı"
                                                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <ui:Button x:Name="AuditScanBtn" Grid.Column="1" Content="🔍 Denetle" Click="AuditScan_Click"
                                               Appearance="Primary" Padding="14,7" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <ItemsControl x:Name="TweakAuditList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Category}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{Binding StatusBackground}" BorderBrush="{Binding StatusBorder}"
                                                        BorderThickness="1" CornerRadius="4" Padding="7,3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding StatusForeground}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= ALTTTAKİ KALICI VE DİNAMİK "DEĞİŞİKLİKLERİ UYGULA" ÇUBUĞU ================= -->
                <Border x:Name="ActionBar" Visibility="Visible" VerticalAlignment="Bottom" Margin="24,0,24,18"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1.5" CornerRadius="12" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Ana İçerik Satırı -->
                        <Grid Grid.Row="0" Margin="16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="ActionBarBadge" Background="#1A64748B" CornerRadius="8" Width="32" Height="32" Margin="0,0,12,0">
                                    <TextBlock x:Name="BadgeCountText" Text="✓" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="StatusTitleText" Text="Sistem Hazır" FontWeight="Bold" FontSize="13" 
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,6,0" />
                                        <TextBlock x:Name="StatusSubBadge" Text="● Beklemede" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="StatusDescText" Text="Kaldırmak istediğiniz uygulamaları veya sistem ayarlarını seçin." 
                                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="CancelBtn" Content="Vazgeç" Click="CancelChanges_Click" Appearance="Secondary" Padding="16,8" Margin="0,0,10,0" IsEnabled="False" />
                                <ui:Button x:Name="ApplyBtn" Content="⚡ Değişiklikleri Uygula" Click="ApplyChanges_Click" Appearance="Primary" Padding="20,8" FontWeight="Bold" IsEnabled="False" />
                            </StackPanel>
                        </Grid>

                        <!-- Kart Tabanına Entegre Akıcı Mavi İlerleme Çubuğu -->
                        <ProgressBar x:Name="ActionProgressBar" Grid.Row="1" Height="3.5" 
                                     Foreground="#3B82F6" Background="#263B82F6" BorderThickness="0" 
                                     Visibility="Collapsed" Minimum="0" Maximum="100" Value="0" />
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ================= SİSTEM & DONANIM KİMLİĞİ MODAL DİYALOĞU (SEÇENEK A: DİKEY AKIŞ) ================= -->
        <Grid x:Name="SystemSpecsOverlay" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="9998" Visibility="Collapsed" Background="#B3000000" MouseLeftButtonDown="SystemSpecsOverlayBackground_Click">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Width="520" MaxWidth="550"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="#6366F1" BorderThickness="1.2"
                    CornerRadius="14" Padding="18,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="45" Color="#000000" Opacity="0.75" Direction="270" ShadowDepth="8" />
                </Border.Effect>
                <StackPanel>
                    <!-- Başlık ve Kapat Butonu -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1A6366F1" BorderBrush="#336366F1" BorderThickness="1" 
                                    CornerRadius="8" Width="34" Height="34" Margin="0,0,10,0">
                                <TextBlock Text="💻" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sistem &amp; Donanım Kimliği" FontSize="15" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Windows lisans durumu ve temel donanım özeti" FontSize="11" 
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <ui:Button Content="✕" Click="CloseSystemSpecsOverlay_Click" 
                                   HorizontalAlignment="Right" Appearance="Secondary" Padding="8,4" />
                    </Grid>

                    <!-- BÖLÜM 1: Windows & Lisans Bilgisi -->
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,8" Padding="0,0,0,4">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔑" FontFamily="Segoe UI Emoji" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Windows &amp; Lisans Bilgisi" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- OS & Sürüm Kartı -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="İŞLETİM SİSTEMİ VE SÜRÜM" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Grid Grid.Row="1" Margin="0,2,0,0">
                                <TextBlock x:Name="SpecsOsFullName" Text="Windows 11 Pro (64-bit)" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="SpecsOsBuildText" Text="23H2 (22631.4317)" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Lisans Durumu Kartı -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="ETKİNLEŞTİRME DURUMU" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Grid Grid.Row="1" Margin="0,3,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="SpecsLicenseBadge" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" CornerRadius="10" Padding="8,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="SpecsLicenseIcon" Text="✓" FontSize="10.5" FontWeight="Bold" Foreground="#10B981" Margin="0,0,5,0" />
                                            <TextBlock x:Name="SpecsLicenseStatusText" Text="Kalıcı Olarak Etkinleştirildi" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="SpecsLicenseSubText" Text="Dijital Lisans" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Lisans Türü & Anahtar Kartı -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="LİSANS TÜRÜ VE KISMİ ANAHTAR" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Grid Grid.Row="1" Margin="0,2,0,0">
                                <TextBlock x:Name="SpecsLicenseChannelText" Text="Perakende (Retail Channel)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <Border HorizontalAlignment="Right" Background="#26000000" BorderBrush="#3393C5FD" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                    <TextBlock x:Name="SpecsPartialKeyText" Text="••••• - 3V66T" FontFamily="Consolas" FontSize="11" Foreground="#93C5FD" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- BÖLÜM 2: Temel Donanım Özeti -->
                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,6" Padding="0,0,0,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontFamily="Segoe UI Emoji" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Temel Donanım Özeti" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 1. Anakart Kartı -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,0,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="ANAKART (MOTHERBOARD)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <ui:Button x:Name="CopyMotherboardBtn" Content="📋" Click="CopyMotherboard_Click" Appearance="Secondary" Padding="5,1" HorizontalAlignment="Right" ToolTip="Anakart modelini kopyala" />
                            </Grid>
                            <TextBlock x:Name="SpecsMotherboardText" Grid.Row="1" Text="MSI B450 GAMING PLUS MAX" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                        </Grid>
                    </Border>

                    <!-- 2. Ekran Kartı Kartı -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,0,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="EKRAN KARTI (GPU)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <ui:Button x:Name="CopyGpuBtn" Content="📋" Click="CopyGpu_Click" Appearance="Secondary" Padding="5,1" HorizontalAlignment="Right" ToolTip="Ekran kartı adını kopyala" />
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,3,0,0">
                                <TextBlock x:Name="SpecsGpuText" Text="NVIDIA GeForce GTX 1050 Ti" FontSize="11.5" FontWeight="SemiBold" Foreground="#86EFAC" HorizontalAlignment="Left" />
                                <TextBlock x:Name="SpecsGpuVramText" Text=" · 4 GB" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="SpecsGpuDriverText" Grid.Row="2" Text="Sürücü: 566.03 WHQL" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" Margin="0,2,0,0" />
                        </Grid>
                    </Border>

                    <!-- 3. İşlemci Kartı -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,0,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="İŞLEMCİ (CPU)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <ui:Button x:Name="CopyCpuBtn" Content="📋" Click="CopyCpu_Click" Appearance="Secondary" Padding="5,1" HorizontalAlignment="Right" ToolTip="İşlemci modelini kopyala" />
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,3,0,0">
                                <TextBlock x:Name="SpecsCpuText" Text="AMD Ryzen 5 2600X Six-Core Processor" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="SpecsCpuCoresText" Text=" · 12 Çekirdek" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 4. Bellek (RAM) Kartı -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,0,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="BELLEK (RAM)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,3,0,0">
                                <TextBlock x:Name="SpecsRamText" Text="16 GB RAM" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="SpecsRamAvailText" Text=" (8,5 GB Kullanılabilir)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 5. BIOS Sürümü Kartı -->
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="BIOS SÜRÜMÜ" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <ui:Button x:Name="CopyBiosBtn" Content="📋" Click="CopyBios_Click" Appearance="Secondary" Padding="5,1" HorizontalAlignment="Right" ToolTip="BIOS sürümünü kopyala" />
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,3,0,0">
                                <TextBlock x:Name="SpecsBiosText" Text="Sürüm: H.P3" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="SpecsBiosDateText" Text=" · Tarih: 17.08.2026" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Alt Butonlar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="📋 Özeti Kopyala" Click="CopyAllSpecs_Click" Appearance="Secondary" Margin="0,0,6,0" HorizontalAlignment="Stretch" />
                        <ui:Button Grid.Column="1" Content="⚙️ Windows Ayarları" Click="OpenActivationSettings_Click" Appearance="Secondary" Margin="0,0,6,0" HorizontalAlignment="Stretch" />
                        <ui:Button Grid.Column="2" Content="Kapat" Click="CloseSystemSpecsOverlay_Click" Appearance="Primary" FontWeight="SemiBold" Padding="16,6" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= MODERN WINDOWS 11 FLUENT ONAY & BİLDİRİM DİYALOĞU ================= -->
        <Grid x:Name="ModernDialogOverlay" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="9999" Visibility="Collapsed" Background="#B3000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Width="620" MaxWidth="660"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1.5"
                    CornerRadius="14" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.65" Direction="270" ShadowDepth="8" />
                </Border.Effect>
                <StackPanel>
                    <!-- İkon ve Başlık -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border x:Name="DialogIconBadge" Background="#1A3B82F6" BorderBrush="#333B82F6" BorderThickness="1" 
                                CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock x:Name="DialogIconText" Text="ℹ️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="DialogTitleText" Text="Başlık" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Mesaj ve Açıklama -->
                    <TextBlock x:Name="DialogMessageText" Text="Mesaj içeriği burada yer alacak..." 
                               FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" 
                               TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,22" />

                    <!-- Butonlar (Windows 11 Fluent Buton Düzeni) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Sol: İptal Butonu -->
                        <ui:Button x:Name="DialogCancelBtn" Grid.Column="0" Content="İptal" Click="DialogCancel_Click" 
                                   Appearance="Secondary" Padding="14,8" IsCancel="True" Margin="0,0,16,0" Visibility="Collapsed" />

                        <!-- Sağ: Seçenek ve Birincil Onay Butonları -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button x:Name="DialogSecondaryBtn" Content="Daha Sonra" Click="DialogSecondary_Click" 
                                       Appearance="Secondary" Padding="14,8" Margin="0,0,12,0" Visibility="Collapsed" />
                            <ui:Button x:Name="DialogPrimaryBtn" Content="Tamam" Click="DialogPrimary_Click" 
                                       Appearance="Primary" Padding="18,8" FontWeight="SemiBold" IsDefault="True" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= HAKKINDA KATMANI (OVERLAY) ================= -->
        <Border x:Name="AboutOverlay" Grid.Row="1" Panel.ZIndex="10000"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Visibility="Collapsed"
                MouseLeftButtonDown="AboutOverlay_Click" KeyDown="AboutOverlay_KeyDown">
            <Border Width="540" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    KeyboardNavigation.TabNavigation="Cycle"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="26,22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.55" Direction="270" ShadowDepth="8" />
                </Border.Effect>
                <StackPanel>
                    <!-- Başlık -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Image Source="pack://application:,,,/Assets/PureWin_icon_64.png" Width="40" Height="40"
                               Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PureWin Hakkında" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="AboutVersionText" Text="Sürüm 1.1.0" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Sürüm & Sistem Bilgileri -->
                    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sürüm" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,10,6" />
                            <TextBlock x:Name="AboutVersionValue" Grid.Row="0" Grid.Column="1" Text="-" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text=".NET" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,10,6" />
                            <TextBlock x:Name="AboutDotNetValue" Grid.Row="1" Grid.Column="1" Text="-" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Windows" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,10,6" />
                            <TextBlock x:Name="AboutOsValue" Grid.Row="2" Grid.Column="1" Text="-" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Mimari" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,10,6" />
                            <TextBlock x:Name="AboutArchValue" Grid.Row="3" Grid.Column="1" Text="-" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Yönetici" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,10,6" />
                            <TextBlock x:Name="AboutAdminValue" Grid.Row="4" Grid.Column="1" Text="-" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Konum" FontSize="11.5" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,10,0" />
                            <TextBlock x:Name="AboutPathValue" Grid.Row="5" Grid.Column="1" Text="-" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>
                    </Border>

                    <!-- Sorumluluk Reddi -->
                    <Border Background="#1AEF4444" BorderBrush="#40EF4444" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="⚠ Sorumluluk Reddi" FontSize="12" FontWeight="Bold" Foreground="#F87171" Margin="0,0,0,4" />
                            <TextBlock Text="Bu program ile yapılan tüm işlemler (sistem ayarları, temizlik, DNS değişiklikleri vb.) kullanıcının kendi sorumluluğundadır. Oluşabilecek sorun veya veri kayıplarından kullanıcı sorumludur; önemli işlemler öncesinde yedek almanız önerilir."
                                       FontSize="11.5" TextWrapping="Wrap" LineHeight="17" Foreground="#FCA5A5" />
                        </StackPanel>
                    </Border>

                    <!-- Alt: Telif + Kapat -->
                    <Grid>
                        <TextBlock Text="© 2026 hcorc (PureWin Project)" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button x:Name="AboutGitHubBtn" Content="GitHub'da Aç" Click="AboutGitHub_Click"
                                       Appearance="Secondary" Padding="14,7" Margin="0,0,8,0"
                                       AutomationProperties.Name="GitHub sayfasını aç"
                                       ToolTip="https://github.com/hcorc/PureWin">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="14" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button x:Name="AboutCloseBtn" Content="Kapat" Click="AboutClose_Click"
                                       Appearance="Primary" Padding="20,7" IsDefault="True" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</ui:FluentWindow>
